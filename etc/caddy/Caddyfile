# KI-Server: HTTPS im LAN (PRD 8.7)
{
	# Kein HTTP->HTTPS-Redirect auf Port 80 (Port ist per ufw ohnehin gesperrt)
	auto_https disable_redirects
	# Root-CA nicht in den Trust-Store des Servers installieren
	skip_install_trust
}

https://192.168.10.129 {
	tls internal

	# Netdata (Monitoring) unter /netdata/, nur mit Passwort (P7).
	# Der Passwort-Hash liegt nicht im Repo, sondern in /etc/caddy/netdata-auth.caddy
	# (anlegen/ändern: sudo scripts/p7-netdata-passwort.sh).
	redir /netdata /netdata/v3/
	# Die Startseite von Netdata lädt die Oberfläche von app.netdata.cloud (durch die CSP
	# blockiert). Unter /v3/ liegt dieselbe Oberfläche lokal und ohne Tracking.
	redir /netdata/ /netdata/v3/
	handle_path /netdata/* {
		import /etc/caddy/netdata-auth.caddy
		# Die Netdata-Oberfläche enthält Tracking (Google Tag Manager) und Cloud-Aufrufe.
		# Der Browser darf nur Inhalte vom eigenen Server laden und nur dorthin verbinden.
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; form-action 'self'"
		header Referrer-Policy no-referrer
		reverse_proxy 127.0.0.1:19999
	}

	# Eigenes Stylesheet für Open WebUI (blendet Vorlesen und Fortsetzen auch für Admins aus).
	# Ersetzt die leere /static/custom.css aus dem Image; Quelle etc/caddy/owui/custom.css.
	handle /static/custom.css {
		root * /etc/caddy/owui
		uri strip_prefix /static
		header Cache-Control no-cache
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
